{
  "main": "index.html",
  "preload": "preload/services.js",
  "logo": "logo.png",
  "development": {
    "main": "http://localhost:5173"
  },
  "features": [
    {
      "code": "mdict",
      "explain": "多词典 MDX 查询",
      "cmds": [
        {
          "type": "over",
          "label": "查词",
          "exclude": "/^[\\u4e00-\\u9fa5]+$/",
          "minLength": 1,
          "maxLength": 20
        }
      ]
    },
    {
      "code": "mdict-manage",
      "explain": "管理 MDX 词典列表",
      "cmds": [
        "mdict-manage"
      ]
    }
  ]
}
